.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Distribution & Packaging
build/
dist/
*.egg-info/
*.egg

# Editor & OS Metadata
.vscode/
.idea/
.DS_Store
Thumbs.db